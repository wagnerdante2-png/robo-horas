{
  "bi": {
    "url": "https://app.powerbi.com/",
    "exportWaitSeconds": 900
  },
  "excel": {
    "worksheet": "",
    "storeColumn": "Loja"
  },
  "message": {
    "title": "PARCIAL OPERACIONAL | {loja}",
    "fields": [],
    "maxAutoFields": 10,
    "includeRecordCount": true,
    "footer": "",
    "recipientOverrideEnabled": true,
    "recipientOverrideColumn": "mensagem",
    "recipientOverrideSupportsPlaceholders": true,
    "appendBiDataToCustomMessage": true,
    "biBlockToken": "{dados_bi}",
    "fieldTokenSyntax": "{campo:Nome da coluna}"
  },
  "whatsapp": {
    "dryRun": true,
    "testMode": true,
    "testStore": "ML01",
    "useExistingChromeSession": true,
    "waitSeconds": 12,
    "delayBetweenMessagesSeconds": 4,
    "pauseOnFinish": true,
    "useUiAutomationSend": true,
    "sendButtonNames": ["Enviar", "Send"],
    "sendButtonTimeoutSeconds": 20,
    "continueOnSendError": true,
    "sendRetryCount": 1,
    "sendRetryDelaySeconds": 2,
    "recipientListFile": "data\\destinatarios.csv",
    "useSingleWhatsAppTab": true,
    "navigationGraceMilliseconds": 500,
    "postSendDelayMilliseconds": 500,
    "delayBetweenMessagesMilliseconds": 500
  },
  "schedule": {
    "enabled": false,
    "time": "07:00",
    "days": ["MON", "TUE", "WED", "THU", "FRI", "SAT"],
    "runMissedAsSoonAsPossible": true,
    "preventDuplicateSameDay": true,
    "retryFailedStores": true,
    "requireNetwork": true,
    "lateRunPolicy": "same_day_any_time"
  }
}
